# Change these values before exposing the stack outside localhost.
POSTGRES_PASSWORD=change-this-database-password
JCLOUD_API_KEY=change-this-internal-api-key
WEBUI_SECRET_KEY=change-this-open-webui-secret

# Professor-hosted Qwen Chat Completions API. Never commit the real key.
LLM_BASE_URL=http://114.70.193.174:9000/v1
LLM_API_KEY=replace-with-issued-api-key
LLM_MODEL=qwen3.8-27b
LLM_PROFILE=ko-direct
LLM_TIMEOUT_MS=300000
LLM_MAX_RETRIES=3

# Ollama is retained only for local RAG embeddings.
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Bind only to a private IP when using compose.ollama-node.yaml.
OLLAMA_BIND_IP=127.0.0.1

# Host port for Open WebUI.
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=8080
