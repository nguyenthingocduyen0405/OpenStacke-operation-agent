[Unit]
Description=Cloudflare Quick Tunnel for Kanana Chat
After=network-online.target kanana-chat.service
Wants=network-online.target
Requires=kanana-chat.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
